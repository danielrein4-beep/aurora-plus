# Copiar este archivo a ".env" en el servidor (Hetzner) y llenar los valores
# reales. NUNCA subir el ".env" real a Git — ya está en .gitignore.

# Contraseña de Postgres — cambiar el valor de ejemplo antes de ir a producción.
DB_PASSWORD=cambiar-esta-clave

# API Key de Gemini para el OCR de facturas/tickets (core.ocr.FacturaOcrService,
# tamanacocomercial.TicketOcrService). Sin esto, esos endpoints responden un
# error de configuración claro en vez de fallar el arranque del sistema.
GEMINI_API_KEY=

# Respaldo automático de la base de datos (ver docker/backup/backup.sh) —
# valores por defecto: un respaldo cada 24h, se conservan 14 días.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
