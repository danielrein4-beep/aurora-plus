# Copiar a ".env" en la carpeta del stack (producción o pruebas) y llenar con
# valores reales. NUNCA subir el ".env" real a Git — ya está en .gitignore.
# Ver docs/DESPLIEGUE.md para el procedimiento completo.

# ---------------------------------------------------------------------------
# Identidad del stack
# ---------------------------------------------------------------------------
# Distingue producción de pruebas en el MISMO servidor: nombra el proyecto de
# Docker, los volúmenes y los alias de red. Usar exactamente uno de estos dos:
#   aurora-prod     (en /opt/aurora/production)
#   aurora-staging  (en /opt/aurora/staging)
STACK_NAME=aurora-prod

# Dominio público. El DNS (registro A) debe apuntar a la IP del servidor ANTES
# de levantar el stack: Caddy pide el certificado de Let's Encrypt al arrancar
# y necesita responder en el puerto 80. En local dejar vacío -> "localhost",
# que sirve en HTTP plano sin pedir certificado.
DOMAIN=
# Dominio del entorno de pruebas (ej. staging.tudominio.com). Se define SOLO en
# el .env de producción, porque el Caddy de producción es el que lo publica.
STAGING_DOMAIN=

# URL pública del frontend: en producción es "https://" + el mismo DOMAIN. Se
# usa para armar el link del correo de "olvidé mi clave" (CorreoService).
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DB_NAME=auroraplus_db
DB_USERNAME=postgres
# Obligatoria, sin valor por defecto. Producción y pruebas deben tener
# contraseñas DISTINTAS.
DB_PASSWORD=cambiar-esta-clave

# ---------------------------------------------------------------------------
# Autenticación — CAMBIAR AMBOS antes de producción
# ---------------------------------------------------------------------------
# JWT_SECRET firma todos los tokens de sesión: quien lo tenga puede falsificar
# el acceso a CUALQUIER tenant. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-antes-de-produccion
# Primer administrador de la plataforma, sembrado al arrancar si no existe
# ninguno (SuperAdminDataInitializer).
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=cambiar-esta-clave

# ---------------------------------------------------------------------------
# WhatsApp de la plataforma (códigos de verificación del equipo de administración)
# ---------------------------------------------------------------------------
# Número propio de Aurora Plus en WhatsApp Cloud API. La plantilla debe ser de
# categoría "Autenticación" (cuerpo con {{1}} y botón "Copiar código"), aprobada por Meta.
PLATAFORMA_WHATSAPP_PHONE_NUMBER_ID=
PLATAFORMA_WHATSAPP_TOKEN=
PLATAFORMA_WHATSAPP_PLANTILLA_CODIGO=
# Solo desarrollo local: si SMTP/WhatsApp no están configurados, escribe los
# códigos en el log en vez de fallar. NUNCA en producción.
VERIFICACION_SIMULAR_ENVIO=false

# ---------------------------------------------------------------------------
# Correo saliente (recuperación de clave, informes, récipes)
# ---------------------------------------------------------------------------
# Si SMTP_USERNAME/SMTP_PASSWORD quedan vacíos, la app arranca igual pero NO
# envía correos y el usuario no recibe ningún error claro. Con Gmail, la clave
# es una "contraseña de aplicación", no la del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=notificaciones@auroraplus.app
MAIL_FROM_NAME=Aurora+

# ---------------------------------------------------------------------------
# Servicios opcionales
# ---------------------------------------------------------------------------
# OCR de facturas/tickets (core.ocr.FacturaOcrService, TicketOcrService). Sin
# esto esos endpoints responden 503 CONFIG_ERROR en vez de tumbar el arranque.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Monitoreo de errores (sentry.io). Sin DSN el starter queda inactivo. En el
# servidor es la única forma de enterarse de una excepción sin leer logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# DSN del proyecto de FRONTEND en Sentry (es otro, distinto al del backend).
# Se incrusta al construir la imagen web, así que cambiarlo exige reconstruir.
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Respaldos y recursos
# ---------------------------------------------------------------------------
# Por defecto: un respaldo cada 24h a ./backups del host, se conservan 14 días.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Límites de memoria por contenedor. Valores pensados para un VPS de 4GB
# corriendo producción + pruebas: bajar los del stack de pruebas si hace falta.
APP_MEM_LIMIT=2g
DB_MEM_LIMIT=1g
